{
  "redirects": [
    {
      "source": "/convert",
      "destination": "/convert-to-jpg",
      "permanent": true
    },
    {
      "source": "/en/convert",
      "destination": "/en/convert-to-jpg",
      "permanent": true
    },
    {
      "source": "/resize",
      "destination": "/resize-image",
      "permanent": true
    },
    {
      "source": "/en/resize",
      "destination": "/en/resize-image",
      "permanent": true
    },
    {
      "source": "/webp",
      "destination": "/convert-to-webp",
      "permanent": true
    },
    {
      "source": "/en/webp",
      "destination": "/en/convert-to-webp",
      "permanent": true
    },
    {
      "source": "/presets",
      "destination": "/photo-presets",
      "permanent": true
    },
    {
      "source": "/en/presets",
      "destination": "/en/photo-presets",
      "permanent": true
    },
    {
      "source": "/word-to-pdf",
      "destination": "/convert-word-to-pdf",
      "permanent": true
    },
    {
      "source": "/en/word-to-pdf",
      "destination": "/en/convert-word-to-pdf",
      "permanent": true
    },
    {
      "source": "/ru/onvert-to-jpg",
      "destination": "/ru/convert-to-jpg",
      "permanent": true
    }
  ],
  "functions": {
    "api/word-to-pdf.js": {
      "maxDuration": 60
    },
    "api/pdf-to-word.js": {
      "maxDuration": 60
    },
    "api/convert/init.js": {
      "maxDuration": 30
    },
    "api/convert/status.js": {
      "maxDuration": 15
    },
    "api/convert/cancel.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://vsdezlzorioeazkxtfkt.supabase.co https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.cloudconvert.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; report-uri /api/csp-report"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/tesseract/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
