{
  "redirects": [
    {
      "source": "/convert",
      "destination": "/convert-to-jpg",
      "permanent": true
    },
    {
      "source": "/en/convert",
      "destination": "/en/convert-to-jpg",
      "permanent": true
    },
    {
      "source": "/resize",
      "destination": "/resize-image",
      "permanent": true
    },
    {
      "source": "/en/resize",
      "destination": "/en/resize-image",
      "permanent": true
    },
    {
      "source": "/webp",
      "destination": "/convert-to-webp",
      "permanent": true
    },
    {
      "source": "/en/webp",
      "destination": "/en/convert-to-webp",
      "permanent": true
    },
    {
      "source": "/presets",
      "destination": "/photo-presets",
      "permanent": true
    },
    {
      "source": "/en/presets",
      "destination": "/en/photo-presets",
      "permanent": true
    },
    {
      "source": "/word-to-pdf",
      "destination": "/convert-word-to-pdf",
      "permanent": true
    },
    {
      "source": "/en/word-to-pdf",
      "destination": "/en/convert-word-to-pdf",
      "permanent": true
    },
    {
      "source": "/ru/onvert-to-jpg",
      "destination": "/ru/convert-to-jpg",
      "permanent": true
    }
  ],
  "functions": {
    "api/word-to-pdf.js": {
      "maxDuration": 60
    },
    "api/pdf-to-word.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/tesseract/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
